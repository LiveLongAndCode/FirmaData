<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="WireMock.Net" Version="2.15.0" />
    <!-- OpenTelemetry.* and Serilog.* are NOT listed here: FirmaData.Api is the sole consumer
         and opts out of central package management for them specifically (see its own .csproj)
         because central package management cannot resolve OpenTelemetry.Exporter.Prometheus.
         AspNetCore's prerelease-only version (no stable release exists for it yet) in this
         project's multi-project dependency graph: confirmed by reproducing the same NU1103
         failure with a bracketed exact-version pin and with VersionOverride, and confirming the
         package resolves cleanly both in complete isolation and once CPM is turned off for just
         this project. -->
    <!-- Pinned to the last 7.x release: FluentAssertions 8+ requires a commercial licence
         (Xceed) outside narrow OSS/revenue exemptions; 7.x is the last Apache-2.0 line. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>
</Project>
